#cloud-config
autoinstall:
  version: 1

  locale: de_CH.UTF-8

  keyboard:
    layout: ch

  timezone: Europe/Zurich

  identity:
    hostname: kvcontrol
    username: ubuntu
    password: "$6$jr7iRqqy6HZabA/3$Ix1PUMpe5IUlJ8pyNI8jp7b/4GvFFCBSFVqQUUYQEaGbElNsrCrqCHdEDKmegLQbEOMET0n.Dog4vPfuBHmQp0"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa  insecure@lerncloud

  storage:
    layout:
      name: direct
      
  # Diese Befehle laufen NOCH VOR dem Reboot am Ende der Installation
  late-commands:
    - curtin in-target --target=/target -- touch /boot/lernvirt-installed           

  user-data:
    users:
      - default
      - name: ubuntu
        sudo: ALL=(ALL) NOPASSWD:ALL
        groups: users, admin 
    disable_root: true
    packages:
      - jq
      - curl
      - git
      - git-lfs
      - wget
      - net-tools
      - nmap      
    runcmd:
      - echo "ubuntu:insecure" | chpasswd
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/issue-patch.sh | bash -    
      - curl -sfL https://raw.githubusercontent.com/mc-b/lernvirt/refs/heads/main/scripts/install-lernvirt.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/storage-patch.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/microk8s.sh | bash -
      - sudo su - ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/kubevirt.sh | bash -"
      - microk8s kubectl -n kubevirt patch kubevirt kubevirt --type=merge --patch '{"spec":{"configuration":{"developerConfiguration":{"useEmulation":false}}}}'
      - microk8s enable metrics-server
      - microk8s enable rbac
      - microk8s kubectl apply -f https://raw.githubusercontent.com/headlamp-k8s/headlamp/main/kubernetes-headlamp.yaml
      - microk8s kubectl -n kube-system create serviceaccount headlamp-admin 
      - microk8s kubectl create clusterrolebinding headlamp-admin --serviceaccount=kube-system:headlamp-admin --clusterrole=cluster-admin 
      - microk8s kubectl patch svc headlamp -n kube-system --type=merge -p '{"spec":{"type":"NodePort","ports":[{"port":80,"targetPort":4466,"nodePort":30444}]}}'
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/connectivity-init.sh | TS_HOSTNAME=control bash -"     
      - curl -sfL https://raw.githubusercontent.com/mc-b/lernvirt/main/pxe/install-pxe.sh | bash -     
      - curl -sfL https://raw.githubusercontent.com/mc-b/lernvirt/main/pxe/install-alpine.sh | bash -       
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/wake-on-lan.sh | bash -    
      - snap install k9s && ln -sf /snap/k9s/current/bin/k9s /usr/local/bin/k9s
      
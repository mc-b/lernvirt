#cloud-config

ssh_authorized_keys:
  - ssh-rsa  insecure@lerncloud

autoinstall:
  version: 1

  locale: de_CH.UTF-8

  keyboard:
    layout: ch

  timezone: Europe/Zurich

  identity:
    hostname: k3sws
    username: ubuntu
    password: "$6$jr7iRqqy6HZabA/3$Ix1PUMpe5IUlJ8pyNI8jp7b/4GvFFCBSFVqQUUYQEaGbElNsrCrqCHdEDKmegLQbEOMET0n.Dog4vPfuBHmQp0"

  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - ssh-rsa  insecure@lerncloud

  storage:
    grub:
      update_nvram: true
      reorder_uefi: true
      reorder_uefi_force_fallback: true    
    layout:
      name: direct
      
  # Diese Befehle laufen NOCH VOR dem Reboot am Ende der Installation
  late-commands:
    - curtin in-target --target=/target -- touch /boot/lernvirt-installed
    - |
      if lspci -nn | grep -qi NVIDIA; then
        curtin in-target --target=/target -- bash -c '
          set -x
          apt-get update -y
          # 1. Treiber via ubuntu-drivers installieren (falls noch nicht geschehen)
          DEBIAN_FRONTEND=noninteractive ubuntu-drivers install --gpgpu
          # 2. DYNAMISCHE VERSIONSERMITTLUNG (Sucht nach ii-Paketen mit dreistelligen Nummern wie 580)
          VERSION=$(dpkg -l | grep "^ii" | grep -oP "nvidia-[a-z-]*\K[0-9]{3}(?=-server)" | head -n1)
          # 3. Installation der exakt passenden Server-Utils erzwingen
          if [ -n "$VERSION" ]; then
            DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "nvidia-utils-${VERSION}-server"
          else
            echo "Fehler: Keine installierte NVIDIA-Versionsnummer im dpkg-Log gefunden!"
          fi
        '
      fi  
    
  user-data:
    apt:
      primary:
        - arches: [amd64, i386]
          uri: http://mirror.init7.net/ubuntu  
    users:
      - default
      - name: ubuntu
        sudo: ALL=(ALL) NOPASSWD:ALL
        groups: users, admin 
    disable_root: true
    packages:
      - jq
      - curl
      - git
      - git-lfs
      - wget
      - net-tools
      - nmap      
    runcmd:
      - echo "ubuntu:insecure" | chpasswd
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/issue-patch.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/nfsshare.sh | bash -  
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/storage-patch.sh | bash -  
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/docker.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/containers.sh | bash -      
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/k3scontrol.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/k3scontroladdons.sh | bash - 
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/refs/heads/main/services/nvidia-gpu-operator.sh | bash -"
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/refs/heads/main/services/intel-gpu-operator.sh | bash -"      
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/cert-manager.sh | bash -"         
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/jupyter-lab.sh | SKIP_LIBRARIES=false APPNAME=k3sws bash -"
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/cert-manager.sh | bash -"    
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/kubevirt.sh | bash -"
      - runuser -l ubuntu -c "kubectl -n kubevirt patch kubevirt kubevirt --type=merge --patch '{\"spec\":{\"configuration\":{\"developerConfiguration\":{\"useEmulation\":false}}}}'"
      - runuser -l ubuntu -c "curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/opentelemetry.sh | bash -"    
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/xfce4.sh | DEFAULT_TARGET=graphical bash -     
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/vscode.sh | bash -        
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/cloud-cli.sh | bash -        
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/k8stools.sh | bash -
      - curl -sfL https://raw.githubusercontent.com/mc-b/lerncloud/main/services/wake-on-lan.sh | bash -  
         
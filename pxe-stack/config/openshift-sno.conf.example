# lernvirt OpenShift Single Node (SNO)
# PXE-Basis: /srv/tftp/config/rack.conf

OCP_CHANNEL="stable-4.20"
CLUSTER_NAME="ocp"
BASE_DOMAIN="lernvirt.test"

# PXE-/DNS-Server und SNO-Ziel
PXE_SERVER="10.31.20.11"
SNO_IP="10.31.20.15"
MACHINE_NETWORK_CIDR="10.31.20.0/24"
SNO_HOSTNAME="sno"

# Statisch, weil der SNO-Knoten fest 10.31.20.15 verwenden soll.
SNO_NETWORK_MODE="static"
SNO_INTERFACE="enp2s0"
# SNO_MAC kann weggelassen werden, wenn rack.conf genau einen openshift-sno Host enthaelt.
# SNO_MAC="80:EE:73:EF:0D:E9"
SNO_PREFIX="24"
# auto = Default-Gateway des PXE-Servers; alternativ feste Adresse eintragen.
SNO_GATEWAY="auto"
SNO_DNS="10.31.20.11"

# SNO_MAC wird bei genau einer rack.conf-Regel fuer openshift-sno automatisch erkannt.
INSTALL_DISK="/dev/nvme0n1"

OCP_DIR="/opt/openshift-sno"
PULL_SECRET_FILE="/etc/lernvirt/pull-secret.json"
SSH_KEY_FILE="/etc/lernvirt/lerncloud.pub"

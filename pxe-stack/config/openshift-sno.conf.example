# lernvirt OpenShift SNO PXE Add-on
#
# Diese Konfiguration ist global fuer alle SNO-Zielsysteme.
# Der Clustername kommt aus dem VARIANT-Feld von rack.conf:
#   "80:ee:73:ef:0d:e9|openshift-sno|hf01"

OCP_CHANNEL="stable-4.20"
BASE_DOMAIN="lernvirt.test"

# Alle SNOs liegen in diesem Machine Network.
MACHINE_NETWORK_CIDR="10.31.20.0/24"
CLUSTER_NETWORK_CIDR="10.128.0.0/14"
CLUSTER_HOST_PREFIX="23"
SERVICE_NETWORK_CIDR="172.30.0.0/16"

# Muss auf allen Zielsystemen stimmen.
INSTALL_DISK="/dev/nvme0n1"

# DNS, den der installierte SNO verwenden soll.
DNS_SERVER="10.31.20.11"

# Vor der Installation werden diese Records geprueft:
#   api.<cluster>.<baseDomain>
#   api-int.<cluster>.<baseDomain>
#   test.apps.<cluster>.<baseDomain>
# Alle muessen auf die aktuelle IPv4-Adresse des Zielsystems zeigen.
REQUIRE_DNS="1"
DNS_WAIT_SECONDS="300"

# Vorhandene lernvirt Credentials.
PULL_SECRET_FILE="/etc/lernvirt/pull-secret.json"
SSH_KEY_FILE="/etc/lernvirt/lerncloud.pub"

# Optional: erzwingt erneuten Download/Aufbereitung der gemeinsamen Assets.
OCP_FORCE="0"

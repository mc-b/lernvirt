# lernvirt PXE Stack
#
# Format der Hostregeln:
#   "MAC|STACK|VARIANT"
#
# "*" gilt für alle Rechner. Die Regeln werden von oben nach unten
# ausgewertet; die letzte passende Regel gewinnt.

PXE_SERVER="192.168.1.101"
TFTP_ROOT="/srv/tftp"
HTTP_ROOT="/var/www/html"
INSTALL_DISK="/dev/nvme0n1"

UBUNTU_VERSION="24.04.4"
UBUNTU_CODENAME="noble"
ALPINE_VERSION="3.22"
BOOT_TOOLS="1"
GRUB_TIMEOUT="5"

HOSTS=(
    "*|cna|"

    # Beispiel: einzelner Rechner mit anderem Stack
    # "80:EE:73:EF:0D:E9|cna-full|"

    # Globaler Reset: als letzte Regel aktivieren
    # "*|reset|"
)

#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="${CONFIG:-/srv/tftp/config/rack.conf}"

fail() {
    echo "pxe-prepare: $*" >&2
    exit 1
}

[[ -r "$CONFIG" ]] || fail "Konfiguration nicht lesbar: $CONFIG"
# shellcheck disable=SC1090
source "$CONFIG"

declare -p HOSTS >/dev/null 2>&1 || fail "HOSTS ist nicht definiert"
: "${TFTP_ROOT:?TFTP_ROOT fehlt}"
: "${HTTP_ROOT:?HTTP_ROOT fehlt}"
: "${BOOT_TOOLS:?BOOT_TOOLS fehlt}"

# Nur Regeln ab der letzten *-Regel können effektiv sein. Damit bereitet ein
# globales '*|reset|' am Ende auch wirklich nur den Reset-Stack vor.
last_default=-1
for i in "${!HOSTS[@]}"; do
    IFS='|' read -r selector _ _ <<<"${HOSTS[$i]}"
    selector="${selector//[[:space:]]/}"
    [[ "$selector" == "*" ]] && last_default=$i
done

(( last_default >= 0 )) || fail 'Mindestens eine "*|stack|variant"-Regel ist erforderlich.'

declare -A seen_stack=()
declare -A seen_asset=()
active_stacks=()

for ((i=last_default; i<${#HOSTS[@]}; i++)); do
    IFS='|' read -r _ stack _ <<<"${HOSTS[$i]}"
    stack="${stack//[[:space:]]/}"
    [[ -n "$stack" ]] || fail "HOSTS-Regel $((i+1)): Stack fehlt"
    if [[ -z "${seen_stack[$stack]+x}" ]]; then
        seen_stack[$stack]=1
        active_stacks+=("$stack")
    fi
done

for stack in "${active_stacks[@]}"; do
    cfg="$TFTP_ROOT/grub/stacks/${stack}.cfg"
    [[ -r "$cfg" ]] || fail "Stack existiert nicht: $cfg"

    # Ubuntu-basierte lernvirt-Stacks benennen ihre Autoinstall-Datei mit
    # 'set userdata="..."'. Bestehende Dateien haben immer Vorrang.
    userdata="$(sed -n 's/^set userdata="\([^"]*\)"/\1/p' "$cfg" | head -n1)"
    if [[ -n "$userdata" && ! -s "$HTTP_ROOT/autoinstall/$userdata" ]]; then
        case "$userdata" in
            user-data|user-data-reset)
                fail "Basis-Autoinstall-Datei fehlt: $HTTP_ROOT/autoinstall/$userdata"
                ;;
            *)
                "$TFTP_ROOT/bin/import-legacy-autoinstall" "$userdata" || \
                    fail "Autoinstall-Datei fehlt: $HTTP_ROOT/autoinstall/$userdata"
                ;;
        esac
    fi

    asset="$(sed -n 's/^# PXE-ASSET:[[:space:]]*//p' "$cfg" | head -n1)"
    [[ -n "$asset" ]] || continue

    if [[ -n "${seen_asset[$asset]+x}" ]]; then
        continue
    fi
    seen_asset[$asset]=1

    preparer="$TFTP_ROOT/bin/prepare-${asset}"
    [[ -x "$preparer" ]] || fail "Kein Asset-Preparer vorhanden: $preparer"

    echo "==> Assets '$asset' für Stack '$stack' vorbereiten"
    "$preparer"
done

if [[ "$BOOT_TOOLS" == "1" ]]; then
    [[ -x "$TFTP_ROOT/bin/prepare-alpine" ]] || fail "prepare-alpine fehlt"
    echo "==> Alpine/BusyBox Boot-Tools vorbereiten"
    "$TFTP_ROOT/bin/prepare-alpine"
fi

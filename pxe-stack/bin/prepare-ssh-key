#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="${CONFIG:-/srv/tftp/config/rack.conf}"
env_key_file="${SSH_KEY_FILE:-}"
env_key_url="https://raw.githubusercontent.com/mc-b/lerncloud/refs/heads/main/ssh/lerncloud.pub"
[[ -r "$CONFIG" ]] && source "$CONFIG"

SSH_KEY_FILE="${env_key_file:-${SSH_KEY_FILE:-/etc/lernvirt/lerncloud.pub}}"
SSH_PUBLIC_KEY_URL="${env_key_url:-${SSH_PUBLIC_KEY_URL:-}}"
SSH_PRIVATE_KEY="${SSH_PRIVATE_KEY:-/home/ubuntu/.ssh/id_rsa_lernvirt}"

valid_key() {
    local file=$1
    [[ -s "$file" ]] || return 1
    grep -Eq '^(ssh-(rsa|ed25519)|ecdsa-sha2-|sk-(ssh-ed25519|ecdsa-sha2-))' "$file"
}

mkdir -p "$(dirname "$SSH_KEY_FILE")"

# Explizite URL aus pxe-stack hat Vorrang.
if [[ -n "$SSH_PUBLIC_KEY_URL" ]]; then
    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    echo "SSH Public Key laden: $SSH_PUBLIC_KEY_URL"
    curl -fsSL --retry 5 --retry-delay 2 "$SSH_PUBLIC_KEY_URL" -o "$tmp"
    valid_key "$tmp" || { echo "Ungueltiger SSH Public Key: $SSH_PUBLIC_KEY_URL" >&2; exit 1; }
    install -m 0644 "$tmp" "$SSH_KEY_FILE"
    echo "SSH Public Key installiert: $SSH_KEY_FILE"
    exit 0
fi

# Bereits vorhandener Public Key bleibt erhalten.
if valid_key "$SSH_KEY_FILE"; then
    echo "SSH Public Key vorhanden: $SSH_KEY_FILE"
    exit 0
fi

# Bestehender lernvirt-Key des ubuntu Users übernehmen.
if valid_key "${SSH_PRIVATE_KEY}.pub"; then
    install -m 0644 "${SSH_PRIVATE_KEY}.pub" "$SSH_KEY_FILE"
    echo "SSH Public Key uebernommen: ${SSH_PRIVATE_KEY}.pub"
    exit 0
fi

# Originalverhalten aus pxe/install-pxe.sh: Key für User ubuntu erzeugen.
if ! id ubuntu >/dev/null 2>&1; then
    echo "User 'ubuntu' existiert nicht; SSH-Key kann nicht erzeugt werden." >&2
    exit 1
fi

ssh_dir="$(dirname "$SSH_PRIVATE_KEY")"
install -d -m 700 -o ubuntu -g ubuntu "$ssh_dir"

cat >"$ssh_dir/config" <<'CFG'
StrictHostKeyChecking no
UserKnownHostsFile /dev/null
LogLevel error
User ubuntu
IdentityFile ~/.ssh/id_rsa_lernvirt
CFG
chown ubuntu:ubuntu "$ssh_dir/config"
chmod 400 "$ssh_dir/config"

if [[ ! -f "$SSH_PRIVATE_KEY" ]]; then
    echo "Erzeuge neuen SSH-Key fuer User ubuntu"
    ssh-keygen -t rsa -b 4096 -N "" -f "$SSH_PRIVATE_KEY" -C "ubuntu@lernvirt-$(date +%F)" >/dev/null
    chown ubuntu:ubuntu "$SSH_PRIVATE_KEY" "${SSH_PRIVATE_KEY}.pub"
    chmod 400 "$SSH_PRIVATE_KEY" "${SSH_PRIVATE_KEY}.pub"
fi

install -m 0644 "${SSH_PRIVATE_KEY}.pub" "$SSH_KEY_FILE"
echo "SSH Public Key installiert: $SSH_KEY_FILE"

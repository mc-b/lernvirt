#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="${CONFIG:-/srv/tftp/config/rack.conf}"
source "$CONFIG"

BASE_URL="${ALPINE_NETBOOT_URL:-https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VERSION}/releases/x86_64/netboot}"

TFTP_DIR="$TFTP_ROOT/linux/alpine"
HTTP_DIR="$HTTP_ROOT/linux/alpine"

mkdir -p "$TFTP_DIR" "$HTTP_DIR"

fail() {
    echo "FEHLER: $*" >&2
    exit 1
}

remote_size() {
    local url=$1
    curl -fsIL --retry 5 --retry-delay 2 "$url" 2>/dev/null \
        | awk 'BEGIN { IGNORECASE=1 } /^content-length:/ { gsub("\\r", "", $2); size=$2 } END { print size }'
}

fetch() {
    local url=$1
    local dest=$2
    local tmp="${dest}.part"
    local expected="" actual=""

    expected="$(remote_size "$url" || true)"

    if [[ "${ALPINE_FORCE:-0}" != "1" && -s "$dest" && "$expected" =~ ^[0-9]+$ ]]; then
        actual="$(stat -c '%s' "$dest" 2>/dev/null || true)"
        if [[ "$actual" = "$expected" ]]; then
            echo "Vorhanden und Groesse korrekt: $dest ($actual Bytes)"
            return 0
        fi
        echo "Datei unvollstaendig/veraltet: $dest (${actual:-0}/${expected} Bytes)"
    elif [[ "${ALPINE_FORCE:-0}" != "1" && -s "$dest" ]]; then
        echo "Remote-Groesse nicht ermittelbar; lade $dest sicherheitshalber neu."
    fi

    rm -f "$tmp"
    echo "Download: $url"
    curl -fL \
        --retry 5 \
        --retry-all-errors \
        --retry-delay 2 \
        "$url" -o "$tmp"

    [[ -s "$tmp" ]] || fail "Leere Datei heruntergeladen: $url"

    if [[ "$expected" =~ ^[0-9]+$ ]]; then
        actual="$(stat -c '%s' "$tmp")"
        if [[ "$actual" != "$expected" ]]; then
            rm -f "$tmp"
            fail "Unvollstaendiger Download: $url (${actual}/${expected} Bytes)"
        fi
    fi

    mv -f "$tmp" "$dest"
}

fetch "$BASE_URL/vmlinuz-lts"   "$TFTP_DIR/vmlinuz-lts"
fetch "$BASE_URL/initramfs-lts" "$TFTP_DIR/initramfs-lts"
fetch "$BASE_URL/modloop-lts"   "$HTTP_DIR/modloop-lts"

# Grobe Plausibilitaetspruefung gegen versehentlich gespeicherte HTML-/Fehlerdateien.
[[ $(stat -c '%s' "$TFTP_DIR/vmlinuz-lts") -gt 5000000 ]] \
    || fail "vmlinuz-lts ist unplausibel klein"
[[ $(stat -c '%s' "$TFTP_DIR/initramfs-lts") -gt 5000000 ]] \
    || fail "initramfs-lts ist unplausibel klein"
[[ $(stat -c '%s' "$HTTP_DIR/modloop-lts") -gt 10000000 ]] \
    || fail "modloop-lts ist unplausibel klein"

echo "Alpine/BusyBox PXE Assets bereit."
echo "  Kernel:    $(stat -c '%s' "$TFTP_DIR/vmlinuz-lts") Bytes"
echo "  Initramfs: $(stat -c '%s' "$TFTP_DIR/initramfs-lts") Bytes"
echo "  Modloop:   $(stat -c '%s' "$HTTP_DIR/modloop-lts") Bytes"

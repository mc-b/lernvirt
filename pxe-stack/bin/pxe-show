#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG="${CONFIG:-/srv/tftp/config/rack.conf}"
[[ -r "$CONFIG" ]] || { echo "Konfiguration fehlt: $CONFIG" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CONFIG"

printf 'PXE Server : %s\n' "$PXE_SERVER"
printf 'HTTP       : http://%s/\n' "$PXE_SERVER"
printf 'TFTP       : %s\n' "$TFTP_ROOT"
printf 'Disk       : %s\n' "$INSTALL_DISK"
printf 'Boot tools : %s\n\n' "$BOOT_TOOLS"

echo "Hostregeln (letzte passende Regel gewinnt):"
n=0
for rule in "${HOSTS[@]}"; do
    n=$((n + 1))
    IFS='|' read -r selector stack variant <<<"$rule"
    printf '  %2d  %-18s -> %-20s %s\n' "$n" "$selector" "$stack" "${variant:-}"
done

echo
echo "Installierte Stacks:"
find "$TFTP_ROOT/grub/stacks" -maxdepth 1 -type f -name '*.cfg' ! -name '_*' \
    -printf '  %f\n' 2>/dev/null | sed 's/\.cfg$//' | sort

echo
if [[ -r "$TFTP_ROOT/grub/hosts.cfg" ]]; then
    if [[ "$CONFIG" -nt "$TFTP_ROOT/grub/hosts.cfg" ]]; then
        echo "WARNUNG: rack.conf ist neuer als die aktive GRUB-Konfiguration."
        echo "         sudo $TFTP_ROOT/bin/pxe-update ausführen."
    else
        echo "GRUB-Konfiguration ist aktuell."
    fi
else
    echo "WARNUNG: $TFTP_ROOT/grub/hosts.cfg fehlt."
fi
